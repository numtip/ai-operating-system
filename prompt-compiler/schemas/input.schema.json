{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ai-os://prompt-compiler/input.schema.json",
  "title": "PromptCompilerInput",
  "type": "object",
  "additionalProperties": false,
  "required": ["project", "goal", "model_profile", "output_mode"],
  "properties": {
    "project": {
      "type": "string",
      "minLength": 1,
      "description": "Project id or folder name under 01_Projects/"
    },
    "goal": {
      "type": "string",
      "minLength": 1,
      "description": "Single measurable outcome"
    },
    "model_profile": {
      "type": "string",
      "minLength": 1,
      "description": "Profile id under prompt-compiler/profiles/"
    },
    "constraints": {
      "type": "array",
      "items": { "type": "string" },
      "default": []
    },
    "output_mode": {
      "type": "string",
      "enum": ["json", "markdown", "both"]
    }
  }
}
